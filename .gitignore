# Ignore following files/directories
*~
._*
*.DS_Store
\#*#
.vagrant
*.iml
tmp

# Keep bin directory for important executables, but ignore compiled binaries
/bin/*
!/bin/.gitkeep

# Ignore benchmark and metrics data
/benchmark_results/
/metrics/

# Ignore editor-specific files
.vscode/
.idea/
*.swp
*.swo

# Ignore logs
*.log

# Ignore KWOK backup and generated files
*.bak
kwok-config-dynamic.yaml

# Python cache files
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/

# Generated analysis files
plots/
raw_data/
