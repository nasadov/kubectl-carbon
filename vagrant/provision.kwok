# Install GO
echo "*** Installing GO ***"
wget https://go.dev/dl/go1.21.8.linux-amd64.tar.gz > /dev/null 2>&1
sudo rm -rf /usr/local/go && sudo tar -C /usr/local -xzf go1.21.8.linux-amd64.tar.gz 
mkdir /home/vagrant/golang
export GOPATH=/home/vagrant/golang
export PATH=$PATH:/usr/local/go/bin:$GOPATH/bin

# Install jq
sudo apt install jq -y

# Install KWOK
KWOK_REPO=kubernetes-sigs/kwok
KWOK_LATEST_RELEASE=$(curl "https://api.github.com/repos/${KWOK_REPO}/releases/latest" | jq -r '.tag_name')

go install sigs.k8s.io/kwok/cmd/{kwok,kwokctl}@${KWOK_LATEST_RELEASE}
sudo cp ./golang/bin/* /usr/local/bin


# Install kubectl
echo "*** Installing Kubectl ***"
curl -LO "https://dl.k8s.io/release/$(curl -L -s https://dl.k8s.io/release/stable.txt)/bin/linux/amd64/kubectl" > /dev/null 2>&1
sudo install -m 0755 kubectl /usr/local/bin/kubectl

# Enable kubectl bash completion 
echo 'source <(kubectl completion bash)' >>~/.bashrc
. .bashrc

# Install make
sudo apt install make


